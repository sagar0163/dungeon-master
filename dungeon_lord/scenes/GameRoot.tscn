<?xml version="1.0" encoding="UTF-8"?>
<GodotScene>

	<root>

		<!-- Root node that manages both Builder and Crawl modes -->
		<node3d name="GameRoot">

			<!-- DungeonGrid shared between both modes -->
			<node3d name="DungeonGrid">

				<!-- Shared grid data model - DungeonGrid.cs -->
				<script name="DungeonGrid">

					<property name="Width" type="int" export="true" value="32" />

					<property name="Height" type="int" export="true" value="32" />

					<property name="Floors" type="int" export="true" value="3" />

				</script>

			</node3d>

			<!-- EssenceManager shared between both modes -->
			<node name="EssenceManager" type="Node">

				<script name="EssenceManager">

					<property name="CurrentEssence" type="long" export="true" value="200" />

					<property name="DungeonRank" type="int" export="true" value="1" />

					<property name="EssenceCapacity" type="long" export="true" value="1000" />

				</script>

			</node>

			<!-- BuilderController for top-down builder mode -->
			<node3d name="BuilderController">

				<script name="BuilderController">

					<property name="DungeonGrid" type="DungeonGrid" export="true" value="0" />

					<property name="EssenceManager" type="EssenceManager" export="true" value="0" />

					<property name="Camera" type="Camera3D" export="true" value="0" />

					<property name="SelectionIndicator" type="MeshInstance3D" export="true" value="0" />

					<property name="PlacementPreview" type="MeshInstance3D" export="true" value="0" />

					<property name="TileSize" type="float" export="true" value="2.0" />

					<property name="GridWidth" type="int" export="true" value="32" />

					<property name="GridHeight" type="int" export="true" value="32" />

					<property name="MaxFloors" type="int" export="true" value="3" />

				</script>

			</node3d>

			<!-- CrawlController for first-person crawl mode -->
			<node3d name="CrawlController">

				<script name="CrawlController">

					<property name="DungeonGrid" type="DungeonGrid" export="true" value="0" />

					<property name="Camera" type="Camera3D" export="true" value="0" />

					<property name="Body" type="CharacterBody3D" export="true" value="0" />

					<property name="MoveDuration" type="float" export="true" value="0.3" />

					<property name="TurnDuration" type="float" export="true" value="0.2" />

					<property name="CameraHeight" type="float" export="true" value="1.6" />

					<property name="TileSize" type="float" export="true" value="2.0" />

				</script>

			</node3d>

			<!-- Mode switcher - Tab key toggles between modes -->
			<script name="ModeSwitcher">

				<signal name="OnModeSwitchRequested" />

				<!-- State -->
				<property name="isCrawlMode" type="bool" export="true" value="false" />

				<signal name="OnTilePlaced" />

			</script>

		</node3d>

	</root>

</GodotScene>